        赋值语句 → 标识符 '=' 表达式
        """
        token = self.peek()
        if token and token[0] == 'IDENTIFIER':
            var_name = token[1]
            self.next_token()
            if self.peek() and self.peek()[1] == '=':
                self.next_token()
                value = self.parse_expression()
